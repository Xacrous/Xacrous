# --- Mode -------------------------------------------------------------
# paper = simulated account (default), live = real orders on the exchange
MODE=paper

# --- Exchange (any ccxt exchange id; Binance spot by default) ----------
EXCHANGE=binance
SYMBOL=BTC/USDT
# Only needed for live mode. Create a key with SPOT TRADING enabled and
# WITHDRAWALS DISABLED, and restrict it to your server's IP address.
API_KEY=
API_SECRET=

# Share of the free USDT balance spent on each buy (0-1)
ALLOCATION=1.0

# --- Paper trading ----------------------------------------------------
PAPER_START_QUOTE=10000
FEE=0.001
# Optional: run in paper mode from a CSV/XLSX file instead of the exchange
# DATA_FILE=data/btc_daily.xlsx

# --- Strategy ---------------------------------------------------------
SMA_LENGTH=100
ENTRY_BAND=0.06
EXIT_BAND=0.04

# --- App --------------------------------------------------------------
DB_PATH=data/bot.db
DASHBOARD_USER=admin
# Required in live mode. Anyone with this password can pause/resume the bot.
DASHBOARD_PASSWORD=
CHECK_INTERVAL_MIN=15
