# Copy of this file is created as .env on first start. Edit .env with Notepad.
# Never share .env: it holds your Binance API keys.

# paper = simulated trades on real Binance prices (no keys needed)
# live  = real orders with the API key below
MODE=paper

# true = with MODE=live, trade on the Binance Spot Testnet (fake money).
# Testnet keys come from https://testnet.binance.vision, not from your real account.
TESTNET=false

# Binance > Profile > API Management > Create API (System generated)
#   Enable Spot & Margin Trading: ON
#   Enable Withdrawals: OFF  (the bot refuses to start if it is on)
#   Restrict access to trusted IPs: ON with your home IP, if your IP does not change
API_KEY=
API_SECRET=

# The dashboard: http://127.0.0.1:8080 . It only listens on this PC.
PORT=8080
