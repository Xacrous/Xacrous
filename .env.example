# Copy to .env, fill in, then: chmod 600 .env
# Never commit .env or share it: it holds your Binance keys.

# --- Server (used by docker-compose / Caddy) --------------------------
# Domain whose DNS A record points at your droplet
DOMAIN=bot.example.com
# Email for Let's Encrypt certificate notices
ACME_EMAIL=you@example.com
# Optional: only these IPs/ranges may open the site (space separated).
# ALLOWED_IPS=203.0.113.7/32

# --- Dashboard login ---------------------------------------------------
DASHBOARD_USER=admin
# python -m app.cli set-password   (stores a hash, not the password)
DASHBOARD_PASSWORD_HASH=
# python -m app.cli setup-2fa      (required in live mode)
TOTP_SECRET=
# Only for testing over plain http://localhost; keep true on the server.
COOKIE_SECURE=true
SESSION_IDLE_MIN=60
SESSION_MAX_HOURS=12

# --- Mode ---------------------------------------------------------------
# paper = simulated account, live = real orders with your Binance API key
MODE=paper
# true = send orders to the Binance Spot Testnet (fake money) instead.
# Testnet keys come from https://testnet.binance.vision, not your real account.
TESTNET=false

# --- Binance ------------------------------------------------------------
EXCHANGE=binance
SYMBOL=BTC/USDT
# Binance > API Management > Create API (System generated):
#   - Restrict access to trusted IPs only: your droplet's IP
#   - Enable Spot & Margin Trading: ON
#   - Enable Withdrawals: OFF (the bot refuses to trade if it is on)
API_KEY=
API_SECRET=

# Share of the free USDT balance spent on each buy (0-1)
ALLOCATION=1.0

# --- Paper trading -----------------------------------------------------
PAPER_START_QUOTE=10000
FEE=0.001
# Optional: paper-trade from a CSV/XLSX file instead of live prices
# DATA_FILE=data/btc_daily.xlsx

# --- Strategy -----------------------------------------------------------
SMA_LENGTH=100
ENTRY_BAND=0.06
EXIT_BAND=0.04
CHECK_INTERVAL_MIN=15
